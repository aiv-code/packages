#!/bin/bash
source /usr/local/lib/aiv/enviroment
# Resolve a JDK via java_home (works whether Java was installed via the
# official pkg, Homebrew, or Adoptium — none of which reliably symlink
# into /usr/bin/java on macOS).
if [ -x /usr/libexec/java_home ]; then
  JAVA_HOME="$(/usr/libexec/java_home -v 17+ 2>/dev/null || /usr/libexec/java_home 2>/dev/null)"
fi
JAVA_BIN="${JAVA_HOME:+$JAVA_HOME/bin/}java"

exec "$JAVA_BIN" -Duser.timezone=${APP_TIMEZONE} -jar /usr/local/lib/aiv/universalauth.jar \
  --spring.config.location=file:/usr/local/lib/aiv/universalauth/application.yml \
  --logging.config=file:/usr/local/lib/aiv/universalauth/logback-spring.xml

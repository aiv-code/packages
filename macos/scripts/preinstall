#!/bin/bash
# pkgbuild preinstall — runs as root before files are laid down.
set -e

if ! /usr/libexec/java_home -v 17+ >/dev/null 2>&1; then
  echo "Warning: no Java 17+ runtime detected via java_home." >&2
  echo "AIV requires Java 17 or later. Install it before starting the service." >&2
fi

exit 0
